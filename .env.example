# Variables de entorno de Khemik. En Render se configuran en Environment;
# en local no son necesarias (se usa SQLite en instance/khemik.db).

# Cadena de conexión de PostgreSQL (Neon > Connection string).
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# "production" activa cookies seguras y exige KHEMIK_SECRET_KEY.
KHEMIK_ENV=production

# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
KHEMIK_SECRET_KEY=

# Opcionales
KHEMIK_SESSION_HOURS=8
KHEMIK_LOGIN_MAX_INTENTOS=5
KHEMIK_LOGIN_BLOQUEO_MINUTOS=15
